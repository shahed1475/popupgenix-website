# Provider selection. "mock" (default) requires no configuration and makes no
# network calls. Set to "claude" to use the real Anthropic API.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=claude. No default model is assumed — startup
# fails with a clear error if AI_PROVIDER=claude and this is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional. One of: low | medium | high | xhigh | max. Defaults to "medium".
ANTHROPIC_EFFORT=

# Required to run `npm run task:research` (the research pipeline). Points at the
# B2B Growth Engine's Postgres instance, using a role that bypasses RLS (RLS policies
# are scoped to auth.uid(), which has no meaning for this automated worker).
#
# Do NOT use the Supabase `postgres` superuser connection string here — it grants far
# more access than this worker needs. Instead, provision a dedicated Postgres role with
# the BYPASSRLS attribute (RLS filters silently instead of erroring, so a role that
# doesn't bypass it just makes claimResearchTasks return zero rows — indistinguishable
# from an empty queue) and grant it only:
#   SELECT on companies, leads
#   INSERT, UPDATE on research, agent_tasks, agent_runs, leads
# Example provisioning (run as an admin, once):
#   CREATE ROLE b2b_worker WITH LOGIN PASSWORD '...' BYPASSRLS;
#   GRANT SELECT ON companies, leads TO b2b_worker;
#   GRANT INSERT, UPDATE ON research, agent_tasks, agent_runs, leads TO b2b_worker;
WORKER_DATABASE_URL=

# Optional. How many pending research tasks to claim and process per invocation.
# Defaults to 5.
WORKER_RESEARCH_BATCH_SIZE=
