# Provider selection. "mock" (default) requires no configuration and makes no
# network calls. Set to "claude" to use the real Anthropic API.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=claude. No default model is assumed — startup
# fails with a clear error if AI_PROVIDER=claude and this is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional. One of: low | medium | high | xhigh | max. Defaults to "medium".
ANTHROPIC_EFFORT=

# Required to run `npm run task:research` (the research pipeline) and
# `npm run task:lead_finder` (the lead ingestion pipeline). Points at the
# B2B Growth Engine's Postgres instance, using a role that bypasses RLS (RLS policies
# are scoped to auth.uid(), which has no meaning for this automated worker).
#
# Do NOT use the Supabase `postgres` superuser connection string here — it grants far
# more access than this worker needs. Instead, provision a dedicated Postgres role with
# the BYPASSRLS attribute (RLS filters silently instead of erroring, so a role that
# doesn't bypass it just makes claimResearchTasks return zero rows — indistinguishable
# from an empty queue) and grant it only:
#   SELECT on companies, leads, lead_sources
#   INSERT, UPDATE on research, agent_tasks, agent_runs, leads, raw_leads, companies, contacts
# (research needs SELECT on companies/leads plus INSERT/UPDATE on research; lead_finder
# additionally reads lead_sources and writes raw_leads, companies, contacts and leads.)
# Example provisioning (run as an admin, once):
#   CREATE ROLE b2b_worker WITH LOGIN PASSWORD '...' BYPASSRLS;
#   GRANT SELECT ON companies, leads, lead_sources TO b2b_worker;
#   GRANT INSERT, UPDATE ON research, agent_tasks, agent_runs, leads, raw_leads, companies, contacts TO b2b_worker;
WORKER_DATABASE_URL=

# Optional. How many pending research tasks to claim and process per invocation.
# Defaults to 5.
WORKER_RESEARCH_BATCH_SIZE=

# Optional. Upper bound handed to each lead source adapter as `limit` — how many raw
# leads a single lead_finder task may discover before it hands off to a continuation
# task via cursor. Defaults to 100.
WORKER_LEAD_FINDER_BATCH_SIZE=

# Required only to run the worker's integration tests (`npm test`). MUST be a database
# DISTINCT from the server's test database: worker/src/test/schema.sql DROPs and rebuilds
# every table it owns on each connection, so pointing this at the server's `drickly_test`
# would destroy the server suite's tables. createTestPool() refuses any database whose
# name does not end in `_worker_test`.
#   TEST_DATABASE_URL=postgresql://drickly_test:drickly_test@localhost:15432/drickly_worker_test
TEST_DATABASE_URL=
