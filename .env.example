DRICKLY_DB_PASSWORD=changeme
DRICKLY_JWT_SECRET=changeme-generate-a-long-random-string-min-32-chars

# Optional — only used by the drickly-worker service (docker compose run --rm drickly-worker ...).
# Left unset, the worker defaults to AI_PROVIDER=mock (no network calls, fabricated placeholder
# results) so it runs with zero extra configuration. Set these to use the real Anthropic API.
WORKER_AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
